---
import '../styles/tokens.css';
import '../styles/base.css';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import { getStrings, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  /** Absolute-path alternates for hreflang, e.g. { en: '/', de: '/de/', ko: '/ko/' } */
  alternates?: Partial<Record<Locale, string>>;
  canonicalPath?: string;
  ogImage?: string;
}
const { title, description = '', lang = 'en', alternates, canonicalPath, ogImage } = Astro.props;
const t = getStrings(lang);
const ogLocale = { en: 'en_US', de: 'de_DE', ko: 'ko_KR' } as const;
const site = Astro.site!;
const canonical = canonicalPath ? new URL(canonicalPath, site).href : undefined;
const ogUrl = ogImage ? new URL(ogImage, site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates && Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, site).href} />)}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Set the theme before first paint: no flash. Stored preference wins, else system.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
