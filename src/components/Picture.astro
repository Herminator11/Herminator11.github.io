---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { lqip } from '../lib/lqip';

interface Props {
  img: ImageMetadata;
  alt: string;
  sizes: string;
  /** Box ratio (w/h). Defaults to the image's own. */
  ratio?: number;
  fit?: 'cover' | 'contain';
  focal?: [number, number];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  tone?: string;
  /** Fill the parent box instead of imposing an aspect ratio (gallery slides). */
  fill?: boolean;
}
const { img, alt, sizes, ratio = img.width / img.height, fit = 'cover', focal = [0.5, 0.5], loading = 'lazy', fetchpriority, tone, fill = false } = Astro.props;
const bg = await lqip(img);
const widths = [480, 800, 1200, 1800].filter((w) => w <= img.width);
if (!widths.length || widths[widths.length - 1] < img.width) widths.push(img.width);
---

<div
  class:list={['pic', Astro.props.class]}
  style={`${fill ? 'width:100%;height:100%;' : `aspect-ratio:${ratio.toFixed(4)};`}${bg ? `background-image:url(${bg});` : ''}${tone ? `background-color:${tone};` : ''}--fit:${fit};--fx:${focal[0] * 100}%;--fy:${focal[1] * 100}%`}
>
  <Picture
    src={img}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={img.width}
    height={img.height}
    quality={72}
  />
</div>

<style is:global>
  .pic { position: relative; overflow: hidden; background-size: cover; background-position: center; background-color: var(--surface); }
  .pic picture, .pic img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pic img { object-fit: var(--fit, cover); object-position: var(--fx, 50%) var(--fy, 50%); }
  .js .pic img:not(.is-loaded) { opacity: 0; }
  .pic img { transition: opacity var(--dur-3) var(--ease-out); }
</style>
