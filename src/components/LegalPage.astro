---
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { getEntry, render } from 'astro:content';
import { getStrings, pathFor, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const entry = (await getEntry('legal', locale))!;
const { Content } = await render(entry);
const legalPath = (l: Locale) => (l === 'en' ? '/legal/' : `/${l}/legal/`);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  lang={locale}
  canonicalPath={legalPath(locale)}
  alternates={{ en: legalPath('en'), de: legalPath('de'), ko: legalPath('ko') }}
>
  <div id="top"></div>
  <main id="main" class="container legal">
    <p class="t-meta"><a href={pathFor(locale)}>{t.footer.home}</a></p>
    <h1 class="t-display">{entry.data.title}</h1>
    <div class="legal__body"><Content /></div>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .legal { padding-block: 3rem 4rem; display: grid; gap: 1.5rem; max-width: 72ch; }
  .legal__body :global(h2) { margin-top: 2.5rem; font-family: var(--font-display, inherit); font-weight: 400; }
  .legal__body :global(p) { margin-block: 0.75rem; line-height: 1.65; }
</style>
