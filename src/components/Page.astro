---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Rail from './Rail.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Resume from './Resume.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { getSite, getAbout } from '../lib/content';
import { getStrings, pathFor, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const site = await getSite(locale);
const about = await getAbout(locale);
---

<Base
  title={site.seoTitle}
  description={site.seoDescription}
  lang={locale}
  canonicalPath={pathFor(locale)}
  alternates={{ en: pathFor('en'), de: pathFor('de'), ko: pathFor('ko') }}
  ogImage={site.ogImage}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: site.title,
    url: new URL(pathFor(locale), Astro.site!).href,
    sameAs: site.socials.map((s) => s.url),
  })} />
  <div id="top"></div>
  <Header locale={locale} />
  <Rail />
  <main id="main">
    <Hero statement={about.statement} rest={about.statementRest} note={getStrings(locale).translationNote} />
    <About locale={locale} />
    <Resume locale={locale} />
    <Projects locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <script>
    import '../scripts/main.ts';
  </script>
</Base>
