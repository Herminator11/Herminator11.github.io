---
import { getSite } from '../lib/content';
import { getStrings, locales, pathFor, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getStrings(locale);
const site = await getSite(locale);
const links = [
  { id: 'about', label: t.nav.about },
  { id: 'resume', label: t.nav.resume },
  { id: 'projects', label: t.nav.projects },
  { id: 'contact', label: t.nav.contact },
];
---

<header class="header" data-header>
  <div class="header__bg" aria-hidden="true"></div>
  <div class="container header__inner">
    <a class="header__brand" href="#top">{site.name}</a>

    <nav class="header__nav" aria-label={t.nav.label}>
      <ul>
        {links.map((l) => <li><a class="navlink" href={`#${l.id}`} data-nav={l.id}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__tools">
      <div class="lang" data-lang-menu>
        <button class="tool lang__btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="lang-list" data-lang-btn aria-label={`${locale.toUpperCase()}, ${t.lang.label}: ${t.lang[locale]}`}>
          <svg class="lang__globe" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 10h14M10 3c2.2 2.2 2.2 11.8 0 14M10 3c-2.2 2.2-2.2 11.8 0 14" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <span>{locale.toUpperCase()}</span>
          <svg class="lang__chev" viewBox="0 0 10 10" width="8" height="8" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <ul class="lang__list" id="lang-list">
          {locales.map((l, i) => (
            <li style={`--n: ${i}`}><a class="lang__item" href={pathFor(l)} hreflang={l} lang={l} data-lang-switch={l} aria-current={l === locale ? 'true' : undefined}>{t.lang[l]}</a></li>
          ))}
        </ul>
      </div>
      <button class="tool tool--icon" type="button" data-theme-toggle data-label={t.theme.label}
        data-l-system={t.theme.system} data-l-light={t.theme.light} data-l-dark={t.theme.dark}>
        <svg class="i i--system" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor"/></svg>
        <svg class="i i--light" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="i i--dark" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16 12.2A6.5 6.5 0 0 1 7.8 4 6.5 6.5 0 1 0 16 12.2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span class="sr-only" data-theme-label></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header { position: fixed; inset: 0 0 auto 0; z-index: 50; height: 4rem; }
  /* Blur layer: only its opacity animates. */
  .header__bg { position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); border-bottom: 1px solid var(--rule); opacity: 0; transition: opacity var(--dur-2) var(--ease-out); }
  :global(.is-scrolled) .header__bg { opacity: 1; }
  .header__inner { position: relative; height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .header__brand { font-family: var(--font-display); font-size: 1.5rem; text-decoration: none; line-height: 1; white-space: nowrap; }
  .header__nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.875rem, 3vw, 1.75rem); }
  .navlink { position: relative; display: inline-block; padding-block: 0.5rem; text-decoration: none; font-size: var(--text-sm); color: var(--ink-muted); transition: color var(--dur-2); }
  .navlink::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.2rem; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-3) var(--ease-out); }
  .navlink:hover { color: var(--ink); }
  .navlink[aria-current='true'] { color: var(--ink); }
  .navlink[aria-current='true']::after { transform: scaleX(1); }
  .header__tools { display: flex; align-items: center; gap: 0.25rem; }
  .tool { display: inline-grid; place-items: center; min-width: 2.5rem; height: 2.75rem; padding: 0; border: 0; background: none; color: var(--ink-muted); font-family: var(--font-mono); font-size: var(--text-xs); text-decoration: none; transition: color var(--dur-1), transform var(--dur-1) var(--ease-out); }
  .tool:hover { color: var(--ink); }
  .tool:active { transform: scale(0.94); }
  .lang { position: relative; }
  .lang__btn { display: inline-flex; gap: 0.375rem; align-items: center; padding-inline: 0.5rem; }
  .lang__chev { transition: transform var(--dur-2) var(--ease-out); }
  .lang__btn[aria-expanded='true'] .lang__chev { transform: rotate(180deg); }
  /* Borderless: plain text lines unfold from the trigger. Only opacity/transform animate. */
  .lang__list { position: absolute; right: 0; top: 100%; z-index: 60; margin: 0; padding: 0 0.5rem 0.5rem; list-style: none; visibility: hidden; pointer-events: none; transition: visibility 0s linear var(--dur-3); }
  :global([data-lang-open]) .lang__list { visibility: visible; pointer-events: auto; transition-delay: 0s; }
  .lang__list::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--bg); opacity: 0; transition: opacity var(--dur-2) var(--ease-out); }
  :global([data-lang-open]) .lang__list::before { opacity: 1; }
  .lang__list li { text-align: right; opacity: 0; transform: translateY(-0.5rem); transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out); }
  :global([data-lang-open]) .lang__list li { opacity: 1; transform: none; transition-delay: calc(var(--n) * 50ms); }
  .lang__item { display: block; min-height: 2.75rem; padding: 0.5rem 0 0.5rem 1.5rem; line-height: 1.75rem; white-space: nowrap; text-decoration: none; font-size: var(--text-sm); color: var(--ink-muted); transition: color var(--dur-1); }
  .lang__item:hover, .lang__item:focus-visible { color: var(--ink); }
  .lang__item[aria-current='true'] { color: var(--ink); }
  .i { display: none; }
  :global([data-theme-state='system']) .i--system, :global([data-theme-state='light']) .i--light, :global([data-theme-state='dark']) .i--dark { display: block; }
  .tool--icon .i--system { display: block; }
  :global([data-theme-state='light']) .tool--icon .i--system, :global([data-theme-state='dark']) .tool--icon .i--system { display: none; }
  @media (max-width: 47.9rem) {
    .header__brand { display: none; }
    .header__inner { justify-content: space-between; }
  }
</style>
